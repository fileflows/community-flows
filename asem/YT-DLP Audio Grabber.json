      "Model": {
        "Code": "WorkingFile=\u0022{file.FullName}\u0022\nOriginalDir=\u0022{folder.Orig.FullName}\u0022\n\n# Run yt-dlp\n/app/common/yt-dlp/yt-dlp \\\n    -a \u0022${WorkingFile}\u0022 \\\n    --output \u0022${OriginalDir}/%(album)s/%(title)s.%(ext)s\u0022 \\\n    --format bestaudio \\\n    --extract-audio \\\n    --audio-format mp3 \\\n    --audio-quality 0 \\\n    --embed-thumbnail \\\n    --embed-metadata \\\n    --convert-thumbnails jpg \\\n    --ppa \u0022EmbedThumbnail\u002Bffmpeg_o:-c:v mjpeg -vf crop=\u0027if(gt(ih,iw),iw,ih):if(gt(iw,ih),ih,iw)\u0027\u0022 \\\n    --yes-playlist\n\necho \u0022Download completed successfully.\u0022\nexit 1",
        "Outputs": 1
      }
    },
